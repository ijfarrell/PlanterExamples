  38:VaDist.cpp    **** /* ====================================================================
  39:VaDist.cpp    ****  *  Circuit Component Constants (from TubeScreamer.m)
  40:VaDist.cpp    ****  * ==================================================================== */
  41:VaDist.cpp    **** static constexpr float R1   = 10.0e3f;       // resistance R1 [Ohms]
  42:VaDist.cpp    **** static constexpr float R2   = 51.0e3f;       // resistance R2 [Ohms]
  43:VaDist.cpp    **** static constexpr float R3   = 4.7e3f;        // resistance R3 [Ohms]
  44:VaDist.cpp    **** static constexpr float C1   = 1.0e-6f;       // capacitance C1 [F]
  45:VaDist.cpp    **** static constexpr float C2   = 51.0e-12f;     // capacitance C2 [F]
  46:VaDist.cpp    **** static constexpr float C3   = 47.0e-9f;      // capacitance C3 [F]
  47:VaDist.cpp    **** 
  48:VaDist.cpp    **** // Diode parameters
  49:VaDist.cpp    **** static constexpr float Is   = 2.52e-9f;      // saturation current [A]
  50:VaDist.cpp    **** static constexpr float Vt   = 25.83e-3f;     // thermal voltage [V]
  51:VaDist.cpp    **** static constexpr float Ni   = 1.752f;        // ideality factor
  52:VaDist.cpp    **** static constexpr float NiVt = Ni * Vt;       // precomputed product
  53:VaDist.cpp    **** 
  54:VaDist.cpp    **** // Newton-Raphson solver limits
  55:VaDist.cpp    **** static constexpr float NR_TOL     = 1e-7f;
  56:VaDist.cpp    **** static constexpr int   NR_MAXITER = 16;       // reduced from MATLAB's 50 for RT budget
  57:VaDist.cpp    **** 
  58:VaDist.cpp    **** /* ====================================================================
  59:VaDist.cpp    ****  *  Globals
  60:VaDist.cpp    ****  * ==================================================================== */
  61:VaDist.cpp    **** static planter euro;
  62:VaDist.cpp    **** 
  63:VaDist.cpp    **** /* Pre-computed matrices (recomputed when drive changes) -------
  64:VaDist.cpp    ****  *   Q  = inv(H_min) * H_plus          (3x3)
  65:VaDist.cpp    ****  *   Qb = inv(H_min) * B               (3x1)
  66:VaDist.cpp    ****  *   Qc = inv(H_min) * C               (3x1)
  67:VaDist.cpp    ****  *   K_coeff = D * inv(H_min) * C      (scalar, = Qc[1])
  68:VaDist.cpp    ****  * These follow the K-method derivation in TubeScreamer.m:
  69:VaDist.cpp    ****  *   H_min   = (2·SR)·I − A
  70:VaDist.cpp    ****  *   H_plus  = (2·SR)·I + A
  71:VaDist.cpp    ****  *   with system matrices A, B, C, D as defined in the MATLAB.
  72:VaDist.cpp    ****  */
  73:VaDist.cpp    **** static float Q[3][3];
  74:VaDist.cpp    **** static float Qb[3];
  75:VaDist.cpp    **** static float Qc[3];
  76:VaDist.cpp    **** static float K_coeff;
  77:VaDist.cpp    **** 
  78:VaDist.cpp    **** /* Per-channel simulation state (allows stereo reuse of shared matrices)
  79:VaDist.cpp    ****  * NOTE: f_prev is intentionally absent. The MATLAB reference never updates
  80:VaDist.cpp    ****  * its f1 variable (it stays 0 for the entire simulation).  Feeding back
  81:VaDist.cpp    ****  * f_prev causes numerical divergence because the diode function produces
  82:VaDist.cpp    ****  * values ~1e20 that get amplified by Qc (~1e5), blowing up the state.  */
  83:VaDist.cpp    **** struct ChannelState
  84:VaDist.cpp    **** {
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccP6lw9u.s 			page 14


  85:VaDist.cpp    ****     float x_prev[3];   // state vector x_{n-1}
  86:VaDist.cpp    ****     float u_prev;      // previous input sample
  87:VaDist.cpp    ****     float v_prev;      // previous diode voltage (NR initial guess)
  88:VaDist.cpp    ****     float tone_lp;     // one-pole LPF tone filter state
  89:VaDist.cpp    ****     float env;         // envelope follower state
  90:VaDist.cpp    ****     float dc_x1;       // DC blocking filter: previous input
  91:VaDist.cpp    ****     float dc_y1;       // DC blocking filter: previous output
  92:VaDist.cpp    **** };
  93:VaDist.cpp    **** 
  94:VaDist.cpp    **** static ChannelState ch_L, ch_R;
  95:VaDist.cpp    **** 
  96:VaDist.cpp    **** /* Envelope follower coefficients (shared) */
  97:VaDist.cpp    **** static float env_attack;   // attack coefficient  (~5 ms)
  98:VaDist.cpp    **** static float env_release;  // release coefficient (~100 ms)
  99:VaDist.cpp    **** 
 100:VaDist.cpp    **** /* Cached control values */
 101:VaDist.cpp    **** static float cur_drive;
 102:VaDist.cpp    **** static float sample_rate;
 103:VaDist.cpp    **** 
 104:VaDist.cpp    **** /* LED flash counter */
 105:VaDist.cpp    **** static int led_flash_ctr = 0;
 106:VaDist.cpp    **** 
 107:VaDist.cpp    **** /* ====================================================================
 108:VaDist.cpp    ****  *  3×3 Matrix Helpers (inline, no heap)
 109:VaDist.cpp    ****  * ==================================================================== */
 110:VaDist.cpp    **** static void mat3_mul(float out[3][3],
 111:VaDist.cpp    ****                      const float a[3][3],
 112:VaDist.cpp    ****                      const float b[3][3])
 113:VaDist.cpp    **** {
 114:VaDist.cpp    ****     for(int i = 0; i < 3; i++)
 115:VaDist.cpp    ****         for(int j = 0; j < 3; j++)
 116:VaDist.cpp    ****             out[i][j] = a[i][0]*b[0][j]
 117:VaDist.cpp    ****                       + a[i][1]*b[1][j]
 118:VaDist.cpp    ****                       + a[i][2]*b[2][j];
 119:VaDist.cpp    **** }
 120:VaDist.cpp    **** 
 121:VaDist.cpp    **** static void mat3_vec(float out[3],
 122:VaDist.cpp    ****                      const float m[3][3],
 123:VaDist.cpp    ****                      const float v[3])
 124:VaDist.cpp    **** {
 125:VaDist.cpp    ****     for(int i = 0; i < 3; i++)
 126:VaDist.cpp    ****         out[i] = m[i][0]*v[0] + m[i][1]*v[1] + m[i][2]*v[2];
 127:VaDist.cpp    **** }
 128:VaDist.cpp    **** 
 129:VaDist.cpp    **** static bool mat3_inv(float out[3][3], const float m[3][3])
 130:VaDist.cpp    **** {
 131:VaDist.cpp    ****     float det = m[0][0]*(m[1][1]*m[2][2] - m[1][2]*m[2][1])
 132:VaDist.cpp    ****               - m[0][1]*(m[1][0]*m[2][2] - m[1][2]*m[2][0])
 133:VaDist.cpp    ****               + m[0][2]*(m[1][0]*m[2][1] - m[1][1]*m[2][0]);
 134:VaDist.cpp    ****     if(fabsf(det) < 1e-30f) return false;
 135:VaDist.cpp    ****     float id = 1.0f / det;
 136:VaDist.cpp    ****     out[0][0] =  (m[1][1]*m[2][2] - m[1][2]*m[2][1]) * id;
 137:VaDist.cpp    ****     out[0][1] = -(m[0][1]*m[2][2] - m[0][2]*m[2][1]) * id;
 138:VaDist.cpp    ****     out[0][2] =  (m[0][1]*m[1][2] - m[0][2]*m[1][1]) * id;
 139:VaDist.cpp    ****     out[1][0] = -(m[1][0]*m[2][2] - m[1][2]*m[2][0]) * id;
 140:VaDist.cpp    ****     out[1][1] =  (m[0][0]*m[2][2] - m[0][2]*m[2][0]) * id;
 141:VaDist.cpp    ****     out[1][2] = -(m[0][0]*m[1][2] - m[0][2]*m[1][0]) * id;
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccP6lw9u.s 			page 15


 142:VaDist.cpp    ****     out[2][0] =  (m[1][0]*m[2][1] - m[1][1]*m[2][0]) * id;
 143:VaDist.cpp    ****     out[2][1] = -(m[0][0]*m[2][1] - m[0][1]*m[2][0]) * id;
 144:VaDist.cpp    ****     out[2][2] =  (m[0][0]*m[1][1] - m[0][1]*m[1][0]) * id;
 145:VaDist.cpp    ****     return true;
 146:VaDist.cpp    **** }
 147:VaDist.cpp    **** 
 148:VaDist.cpp    **** /* ====================================================================
 149:VaDist.cpp    ****  *  RecomputeMatrices – call once per block when drive changes
 150:VaDist.cpp    ****  *
 151:VaDist.cpp    ****  *  Derives Q, Qb, Qc, K_coeff from the circuit component values
 152:VaDist.cpp    ****  *  and the current Rdist = drive * 50 kΩ  (drive ∈ [0, 100]).
 153:VaDist.cpp    ****  * ==================================================================== */
 154:VaDist.cpp    **** static void RecomputeMatrices(float drive, float sr)
 155:VaDist.cpp    **** {
 156:VaDist.cpp    ****     float rdist = drive * 50.0e3f;
 157:VaDist.cpp    ****     if(rdist < 1.0f) rdist = 1.0f;          // numerical safety
 158:VaDist.cpp    **** 
 159:VaDist.cpp    ****     /* System matrix  A  (negated in MATLAB source) */
 160:VaDist.cpp    ****     float A[3][3] = {
 161:VaDist.cpp    ****         { -1.0f/(R1*C1),   0.0f,                     0.0f           },
 162:VaDist.cpp    ****         { -1.0f/(R3*C2),  -1.0f/((R2 + rdist)*C2),  -1.0f/(R3*C2)  },
 163:VaDist.cpp    ****         { -1.0f/(R3*C3),   0.0f,                     -1.0f/(R3*C3)  }
 164:VaDist.cpp    ****     };
 165:VaDist.cpp    **** 
 166:VaDist.cpp    ****     float two_sr = 2.0f * sr;
 167:VaDist.cpp    **** 
 168:VaDist.cpp    ****     /* H_minus = (2/k)·I − A ,  H_plus = (2/k)·I + A */
 169:VaDist.cpp    ****     float Hm[3][3], Hp[3][3];
 170:VaDist.cpp    ****     for(int i = 0; i < 3; i++)
 171:VaDist.cpp    ****         for(int j = 0; j < 3; j++)
 172:VaDist.cpp    ****         {
 173:VaDist.cpp    ****             float eye = (i == j) ? two_sr : 0.0f;
 174:VaDist.cpp    ****             Hm[i][j] = eye - A[i][j];
 175:VaDist.cpp    ****             Hp[i][j] = eye + A[i][j];
 176:VaDist.cpp    ****         }
 177:VaDist.cpp    **** 
 178:VaDist.cpp    ****     float inv_Hm[3][3] = {};
 179:VaDist.cpp    ****     mat3_inv(inv_Hm, Hm);
 180:VaDist.cpp    **** 
 181:VaDist.cpp    ****     /* B and C vectors (from MATLAB) */
 182:VaDist.cpp    ****     float B[3] = { 1.0f/(R1*C1),  1.0f/(R3*C2),  1.0f/(R3*C3) };
 183:VaDist.cpp    ****     float Cv[3] = { 0.0f,         -1.0f/C2,       0.0f          };
 184:VaDist.cpp    **** 
 185:VaDist.cpp    ****     mat3_mul(Q,  inv_Hm, Hp);       // Q  = inv(Hm) · Hp
 186:VaDist.cpp    ****     mat3_vec(Qb, inv_Hm, B);        // Qb = inv(Hm) · B
 187:VaDist.cpp    ****     mat3_vec(Qc, inv_Hm, Cv);       // Qc = inv(Hm) · C
 188:VaDist.cpp    **** 
 189:VaDist.cpp    ****     K_coeff = Qc[1];                 // K = D · Qc , D=[0,1,0]
 190:VaDist.cpp    **** }
 191:VaDist.cpp    **** 
 192:VaDist.cpp    **** /* ====================================================================
 193:VaDist.cpp    ****  *  ProcessSample – one sample of the tube screamer K-method
 194:VaDist.cpp    ****  *
 195:VaDist.cpp    ****  *  Optimised for Cortex-M7:
 196:VaDist.cpp    ****  *   • sinh/cosh pair computed from a single expf() call
 197:VaDist.cpp    ****  *   • asymmetric pair computed from a single expf() call
 198:VaDist.cpp    ****  *   • diode voltage clamped to avoid FP overflow
