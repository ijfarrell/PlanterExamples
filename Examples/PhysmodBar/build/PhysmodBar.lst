   1:PhysmodBar.cpp **** /**
   2:PhysmodBar.cpp ****  * PhysmodBar.cpp — Physical model of a stiff string / bar for the Anachrome Electronics Planter.
   3:PhysmodBar.cpp ****  *
   4:PhysmodBar.cpp ****  * Ported from Stefan Bilbao, Numerical Sound Synthesis, 2009 Stiff String code example (MATLAB),
   5:PhysmodBar.cpp ****  * with modifications for real-time control and performance, 
   6:PhysmodBar.cpp ****  * including polyphonic voice allocation for multiple simultaneous strikes.
   7:PhysmodBar.cpp ****  *
   8:PhysmodBar.cpp ****  * Trigger sources: Planter button (rising edge) or Gate In 1.
   9:PhysmodBar.cpp ****  * Knob map (values captured at the instant of each trigger):
  10:PhysmodBar.cpp ****  *   KNOB 1 – Pitch             (MIDI note 24–96, C1–C7)
  11:PhysmodBar.cpp ****  *   KNOB 2 – Strike Width      (0.1–1.0)
  12:PhysmodBar.cpp ****  *   KNOB 3 – Strike/Pluck blend (0=pure strike, 1=pure pluck)
  13:PhysmodBar.cpp ****  *   KNOB 4 – Decay             (T60 base 0.5–10 s)
  14:PhysmodBar.cpp ****  *   KNOB 5 – Fine tune         (-1 to +1 semitone)
  15:PhysmodBar.cpp ****  *   KNOB 6 – Brightness        (high-freq T60 ratio, 0.1–1.0)
  16:PhysmodBar.cpp ****  *
  17:PhysmodBar.cpp ****  * Toggle 1: Excitation position (up = 0.4, down = 0.05 along the bar)
  18:PhysmodBar.cpp ****  *
  19:PhysmodBar.cpp ****  * CV In 1 is read at trigger time and added as 1 V/oct pitch offset.
  20:PhysmodBar.cpp ****  *
  21:PhysmodBar.cpp ****  * LED 1 flashes on each new strike; LED 2 indicates voice activity.
  22:PhysmodBar.cpp ****  *
  23:PhysmodBar.cpp ****  * Stereo output uses two readout positions (0.30 / 0.70) to create stereo image from single strike
  24:PhysmodBar.cpp ****  */
  25:PhysmodBar.cpp **** 
  26:PhysmodBar.cpp **** #include "daisy_patch_sm.h"
  27:PhysmodBar.cpp **** #include "daisysp.h"
  28:PhysmodBar.cpp **** #include "planter.h"
  29:PhysmodBar.cpp **** #include <cmath>
  30:PhysmodBar.cpp **** #include <cstring>
  31:PhysmodBar.cpp **** 
  32:PhysmodBar.cpp **** using namespace daisy;
  33:PhysmodBar.cpp **** using namespace patch_sm;
  34:PhysmodBar.cpp **** using namespace daisysp;
  35:PhysmodBar.cpp **** using namespace anachrome;
  36:PhysmodBar.cpp **** 
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccAwOTrI.s 			page 16


  37:PhysmodBar.cpp **** /* ====================================================================
  38:PhysmodBar.cpp ****  *  Compile-time configuration
  39:PhysmodBar.cpp ****  * ==================================================================== */
  40:PhysmodBar.cpp **** static constexpr int   MAX_N       = 24;     // max spatial grid segments
  41:PhysmodBar.cpp **** static constexpr int   MAX_VOICES  = 4;       // max simultaneous strikes
  42:PhysmodBar.cpp **** static constexpr float MAX_TF      = 10.0f;   // max strike duration (s)
  43:PhysmodBar.cpp **** static constexpr float SILENCE_THR = 1e-7f;   // voice deactivation threshold
  44:PhysmodBar.cpp **** static constexpr int   ATTACK_SAMPS = 48;      // ~1 ms attack ramp at 48 kHz
  45:PhysmodBar.cpp **** static constexpr float OUTPUT_GAIN = 300.0f; // readout-to-audio scaling
  46:PhysmodBar.cpp **** // PI_F is already defined as a macro in DaisySP/Source/Utility/dsp.h
  47:PhysmodBar.cpp **** static constexpr float STEAL_DECAY = 0.99f;   // voice-steal fade ~2 ms at 48 kHz
  48:PhysmodBar.cpp **** 
  49:PhysmodBar.cpp **** /* Shared temp buffer - reused serially by each voice inside the callback */
  50:PhysmodBar.cpp **** static float tmp_rhs[MAX_N];
  51:PhysmodBar.cpp **** 
  52:PhysmodBar.cpp **** /* ====================================================================
  53:PhysmodBar.cpp ****  *  StiffStringVoice – one concurrent finite-difference strike
  54:PhysmodBar.cpp ****  *
  55:PhysmodBar.cpp ****  *  Implements an implicit FD scheme for the stiff string equation
  56:PhysmodBar.cpp ****  *  with clamped boundary conditions and two-parameter frequency-
  57:PhysmodBar.cpp ****  *  dependent loss.  All matrices are banded (tri- or penta-diagonal)
  58:PhysmodBar.cpp ****  *  and stored as scalar coefficients.  The tridiagonal solve uses a
  59:PhysmodBar.cpp ****  *  pre-factored Thomas algorithm (O(N) per sample).
  60:PhysmodBar.cpp ****  * ==================================================================== */
  61:PhysmodBar.cpp **** struct StiffStringVoice
  62:PhysmodBar.cpp **** {
  63:PhysmodBar.cpp ****     /* --- state --- */
  64:PhysmodBar.cpp ****     bool active     = false;
  65:PhysmodBar.cpp ****     int  N          = 0;      // grid segments
  66:PhysmodBar.cpp ****     int  n_int      = 0;      // interior points = N-1
  67:PhysmodBar.cpp ****     int  NF         = 0;      // max samples for this strike
  68:PhysmodBar.cpp ****     int  sample_idx = 0;
  69:PhysmodBar.cpp **** 
  70:PhysmodBar.cpp ****     /* Grid displacement (interior points only; boundaries = 0) */
  71:PhysmodBar.cpp ****     float u [MAX_N];          // current step
  72:PhysmodBar.cpp ****     float u1[MAX_N];          // previous step
  73:PhysmodBar.cpp ****     float u2[MAX_N];          // two steps back
  74:PhysmodBar.cpp **** 
  75:PhysmodBar.cpp ****     /* Pre-factored Thomas coefficients for tridiagonal A */
  76:PhysmodBar.cpp ****     float th_c   [MAX_N];    // modified super-diagonal
  77:PhysmodBar.cpp ****     float th_invm[MAX_N];    // 1 / modified main diagonal
  78:PhysmodBar.cpp ****     float A_off;              // off-diagonal value of A (symmetric)
  79:PhysmodBar.cpp **** 
  80:PhysmodBar.cpp ****     /* Tridiagonal C (loss complement) */
  81:PhysmodBar.cpp ****     float C_main, C_off;
  82:PhysmodBar.cpp **** 
  83:PhysmodBar.cpp ****     /* Pentadiagonal B (wave + stiffness) */
  84:PhysmodBar.cpp ****     float B_main, B_off1, B_off2;
  85:PhysmodBar.cpp **** 
  86:PhysmodBar.cpp ****     /* Stereo readout interpolation */
  87:PhysmodBar.cpp ****     int   rp_idx [2];
  88:PhysmodBar.cpp ****     float rp_frac[2];
  89:PhysmodBar.cpp **** 
  90:PhysmodBar.cpp ****     /* Attack ramp: eliminates click from pluck initial-condition discontinuity */
  91:PhysmodBar.cpp ****     float attack_env = 0.0f;
  92:PhysmodBar.cpp ****     float attack_inc = 0.0f;
  93:PhysmodBar.cpp **** 
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccAwOTrI.s 			page 17


  94:PhysmodBar.cpp ****     /* Voice-steal fade (applied externally in audio callback, not in Process) */
  95:PhysmodBar.cpp ****     float steal_env  = 1.0f;
  96:PhysmodBar.cpp ****     bool  fading_out = false;
  97:PhysmodBar.cpp ****     struct PendingParams {
  98:PhysmodBar.cpp ****         float SR, B_param, f0, TF, ctr, wid, u0, v0;
  99:PhysmodBar.cpp ****         float loss_f1, loss_t1, loss_f2, loss_t2, rp1, rp2;
 100:PhysmodBar.cpp ****     };
 101:PhysmodBar.cpp ****     PendingParams pending;
 102:PhysmodBar.cpp **** 
 103:PhysmodBar.cpp ****     void BeginFadeOut(float SR_, float B_, float f0_, float TF_,
 104:PhysmodBar.cpp ****                       float ctr_, float wid_, float u0_, float v0_,
 105:PhysmodBar.cpp ****                       float lf1_, float lt1_, float lf2_, float lt2_,
 106:PhysmodBar.cpp ****                       float rp1_, float rp2_)
 107:PhysmodBar.cpp ****     {
