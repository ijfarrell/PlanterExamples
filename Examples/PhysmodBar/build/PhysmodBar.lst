 109:PhysmodBar.cpp ****                    lf1_, lt1_, lf2_, lt2_, rp1_, rp2_};
 110:PhysmodBar.cpp ****         fading_out = true;
 111:PhysmodBar.cpp ****         // Don't reset steal_env — let an in-progress fade continue
 112:PhysmodBar.cpp ****     }
