 230:PhysmodBar.cpp **** 
 231:PhysmodBar.cpp ****     /* ---------------------------------------------------------------
 232:PhysmodBar.cpp ****      *  Process – advance one sample, return stereo output
 233:PhysmodBar.cpp ****      * ------------------------------------------------------------- */
 234:PhysmodBar.cpp ****     void Process(float& out_l, float& out_r)
 235:PhysmodBar.cpp ****     {
 236:PhysmodBar.cpp ****         if(!active) { out_l = out_r = 0.0f; return; }
 237:PhysmodBar.cpp **** 
 238:PhysmodBar.cpp ****         const int n = n_int;
 239:PhysmodBar.cpp **** 
 240:PhysmodBar.cpp ****         /* RHS = B·u1 − C·u2  (combined loop, no extra buffer) */
 241:PhysmodBar.cpp ****         for(int i = 0; i < n; i++)
 242:PhysmodBar.cpp ****         {
 243:PhysmodBar.cpp ****             float bv = B_main * u1[i];
 244:PhysmodBar.cpp ****             float cv = C_main * u2[i];
 245:PhysmodBar.cpp ****             if(i > 0)     { bv += B_off1 * u1[i - 1]; cv += C_off * u2[i - 1]; }
 246:PhysmodBar.cpp ****             if(i < n - 1) { bv += B_off1 * u1[i + 1]; cv += C_off * u2[i + 1]; }
 247:PhysmodBar.cpp ****             if(i > 1)       bv += B_off2 * u1[i - 2];
 248:PhysmodBar.cpp ****             if(i < n - 2)   bv += B_off2 * u1[i + 2];
 249:PhysmodBar.cpp ****             tmp_rhs[i] = bv - cv;
 250:PhysmodBar.cpp ****         }
 251:PhysmodBar.cpp **** 
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccAwOTrI.s 			page 40


 252:PhysmodBar.cpp ****         /* Solve A·u = rhs  (Thomas algorithm, pre-factored) */
 253:PhysmodBar.cpp ****         tmp_rhs[0] *= th_invm[0];
 254:PhysmodBar.cpp ****         for(int i = 1; i < n; i++)
 255:PhysmodBar.cpp ****             tmp_rhs[i] = (tmp_rhs[i] - A_off * tmp_rhs[i - 1]) * th_invm[i];
 256:PhysmodBar.cpp ****         for(int i = n - 2; i >= 0; i--)
 257:PhysmodBar.cpp ****             tmp_rhs[i] -= th_c[i] * tmp_rhs[i + 1];
 258:PhysmodBar.cpp **** 
 259:PhysmodBar.cpp ****         /* Copy solution into u */
 260:PhysmodBar.cpp ****         memcpy(u, tmp_rhs, n * sizeof(float));
 261:PhysmodBar.cpp **** 
 262:PhysmodBar.cpp ****         /* Stereo readout with linear interpolation */
 263:PhysmodBar.cpp ****         out_l = (1.0f - rp_frac[0]) * u[rp_idx[0]]
 264:PhysmodBar.cpp ****                 + rp_frac[0] * u[rp_idx[0] + 1];
 265:PhysmodBar.cpp ****         out_r = (1.0f - rp_frac[1]) * u[rp_idx[1]]
 266:PhysmodBar.cpp ****                 + rp_frac[1] * u[rp_idx[1] + 1];
 267:PhysmodBar.cpp **** 
 268:PhysmodBar.cpp ****         /* Attack ramp to avoid click from pluck displacement discontinuity */
 269:PhysmodBar.cpp ****         if(attack_env < 1.0f)
 270:PhysmodBar.cpp ****         {
 271:PhysmodBar.cpp ****             out_l *= attack_env;
 272:PhysmodBar.cpp ****             out_r *= attack_env;
 273:PhysmodBar.cpp ****             attack_env += attack_inc;
 274:PhysmodBar.cpp ****             if(attack_env > 1.0f) attack_env = 1.0f;
 275:PhysmodBar.cpp ****         }
 276:PhysmodBar.cpp **** 
 277:PhysmodBar.cpp ****         /* Shift state: u2 ← u1 ← u */
 278:PhysmodBar.cpp ****         memcpy(u2, u1, n * sizeof(float));
 279:PhysmodBar.cpp ****         memcpy(u1, u,  n * sizeof(float));
 280:PhysmodBar.cpp **** 
 281:PhysmodBar.cpp ****         sample_idx++;
 282:PhysmodBar.cpp **** 
 283:PhysmodBar.cpp ****         /* Deactivate on max duration */
 284:PhysmodBar.cpp ****         if(sample_idx >= NF) { active = false; return; }
 285:PhysmodBar.cpp **** 
 286:PhysmodBar.cpp ****         /* Periodic silence check (every ~4096 samples ≈ 85 ms) */
 287:PhysmodBar.cpp ****         if((sample_idx & 4095) == 0)
 288:PhysmodBar.cpp ****         {
 289:PhysmodBar.cpp ****             float peak = 0.0f;
 290:PhysmodBar.cpp ****             for(int i = 0; i < n; i++)
 291:PhysmodBar.cpp ****             {
 292:PhysmodBar.cpp ****                 float a = fabsf(u[i]);
 293:PhysmodBar.cpp ****                 if(a > peak) peak = a;
 294:PhysmodBar.cpp ****             }
 295:PhysmodBar.cpp ****             if(peak < SILENCE_THR) active = false;
 296:PhysmodBar.cpp ****         }
 297:PhysmodBar.cpp ****     }
 298:PhysmodBar.cpp **** };
 299:PhysmodBar.cpp **** 
