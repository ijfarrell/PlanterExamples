 238:PhysPlateReverb.cpp **** static float DSY_SDRAM_BSS raw_beta_sq[MAX_RAW_MODES];
 239:PhysPlateReverb.cpp **** static float DSY_SDRAM_BSS raw_sigma[MAX_RAW_MODES];
 240:PhysPlateReverb.cpp **** static float DSY_SDRAM_BSS raw_phi_i[MAX_RAW_MODES];
 241:PhysPlateReverb.cpp **** static float DSY_SDRAM_BSS raw_phi_o_l[MAX_RAW_MODES];
 242:PhysPlateReverb.cpp **** static float DSY_SDRAM_BSS raw_phi_o_r[MAX_RAW_MODES];
 243:PhysPlateReverb.cpp **** 
