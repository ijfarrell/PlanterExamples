   1:PhysPlateReverb.cpp **** /*
   2:PhysPlateReverb.cpp ****  * ===========================================================================
   3:PhysPlateReverb.cpp ****  * PhysPlateReverb.cpp
   4:PhysPlateReverb.cpp ****  *
   5:PhysPlateReverb.cpp ****  * Physical Modeling Plate Reverb for Daisy + Planter (Eurorack)
   6:PhysPlateReverb.cpp ****  * Ported from plateReverbSRC.m (MATLAB) — B221438
   7:PhysPlateReverb.cpp ****  *
   8:PhysPlateReverb.cpp ****  * This replaces the DaisySP ReverbSc with a true modal plate reverb
   9:PhysPlateReverb.cpp ****  * derived from the physical wave equation on a rectangular plate. The
  10:PhysPlateReverb.cpp ****  * algorithm computes the eigenfrequencies (modes) of a tensioned plate,
  11:PhysPlateReverb.cpp ****  * prunes redundant/inaudible modes, then runs a second-order modal
  12:PhysPlateReverb.cpp ****  * filter bank in real time.
  13:PhysPlateReverb.cpp ****  *
  14:PhysPlateReverb.cpp ****  * Two output pickup positions are used for stereo (one per channel).
  15:PhysPlateReverb.cpp ****  *
  16:PhysPlateReverb.cpp ****  * ===========================================================================
  17:PhysPlateReverb.cpp ****  *
  18:PhysPlateReverb.cpp ****  * -------------------------------------------------------------------------
  19:PhysPlateReverb.cpp ****  *   MATLAB  →  C++  VECTOR MATH TRANSLATION GUIDE
  20:PhysPlateReverb.cpp ****  * -------------------------------------------------------------------------
  21:PhysPlateReverb.cpp ****  *
  22:PhysPlateReverb.cpp ****  * KEY CONCEPT: In MATLAB, most math operates on entire vectors/matrices
  23:PhysPlateReverb.cpp ****  * at once using "vectorized" operations. In C++, we don't have that —
  24:PhysPlateReverb.cpp ****  * we use plain arrays (float[]) and explicit for-loops to do the same
  25:PhysPlateReverb.cpp ****  * thing, one element at a time.
  26:PhysPlateReverb.cpp ****  *
  27:PhysPlateReverb.cpp ****  * Here's a side-by-side conversion reference used throughout this file:
  28:PhysPlateReverb.cpp ****  *
  29:PhysPlateReverb.cpp ****  * ╔═══════════════════════════════
  30:PhysPlateReverb.cpp ****  * ║  MATLAB                           ║  C++ Equivalent                        ║
  31:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  32:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  33:PhysPlateReverb.cpp ****  * ║  a = zeros(N,1)                   ║  float a[N];                           ║
  34:PhysPlateReverb.cpp ****  * ║  % Creates an Nx1 column vector   ║  memset(a, 0, N * sizeof(float));      ║
  35:PhysPlateReverb.cpp ****  * ║  % of all zeros.                  ║  // Declares a fixed-size array of N   ║
  36:PhysPlateReverb.cpp ****  * ║                                   ║  // floats, then fills with 0 bytes.   ║
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 16


  37:PhysPlateReverb.cpp ****  * ║                                   ║  // No dynamic sizing! N must be a     ║
  38:PhysPlateReverb.cpp ****  * ║                                   ║  // compile-time constant.             ║
  39:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  40:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  41:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  42:PhysPlateReverb.cpp ****  * ║  c = a .* b                       ║  for (int i = 0; i < N; i++)           ║
  43:PhysPlateReverb.cpp ****  * ║  % Element-wise multiply. Each    ║      c[i] = a[i] * b[i];               ║
  44:PhysPlateReverb.cpp ****  * ║  % entry in c is the product of   ║  // Identical behavior: multiply each  ║
  45:PhysPlateReverb.cpp ****  * ║  % matching entries in a and b.   ║  // pair of elements and store result. ║
  46:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  47:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  48:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  49:PhysPlateReverb.cpp ****  * ║  c = a + b                        ║  for (int i = 0; i < N; i++)           ║
  50:PhysPlateReverb.cpp ****  * ║  % Element-wise addition.         ║      c[i] = a[i] + b[i];               ║
  51:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  52:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  53:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  54:PhysPlateReverb.cpp ****  * ║  s = sum(a .* b)                  ║  float s = 0.0f;                       ║
  55:PhysPlateReverb.cpp ****  * ║  % Dot product: multiply element- ║  for (int i = 0; i < N; i++)           ║
  56:PhysPlateReverb.cpp ****  * ║  % wise then sum all results into ║      s += a[i] * b[i];                 ║
  57:PhysPlateReverb.cpp ****  * ║  % a single scalar.               ║  // Accumulate products into one sum.  ║
  58:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  59:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  60:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  61:PhysPlateReverb.cpp ****  * ║  c = a * scalar                   ║  for (int i = 0; i < N; i++)           ║
  62:PhysPlateReverb.cpp ****  * ║  % Multiply every element of a    ║      c[i] = a[i] * scalar;             ║
  63:PhysPlateReverb.cpp ****  * ║  % by a single number.            ║  // Same: scale each element.          ║
  64:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  65:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  66:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  67:PhysPlateReverb.cpp ****  * ║  [MX,MY] = meshgrid(1:Mx, 1:My)   ║  for (int mx = 1; mx <= Mx; mx++)      ║
  68:PhysPlateReverb.cpp ****  * ║  % Creates 2D grids of all (mx,   ║    for (int my = 1; my <= My; my++)    ║
  69:PhysPlateReverb.cpp ****  * ║  % my) index combinations.        ║      // process pair (mx, my)          ║
  70:PhysPlateReverb.cpp ****  * ║  mx = reshape(MX, [Mx*My, 1])     ║  // A nested for-loop generates every  ║
  71:PhysPlateReverb.cpp ****  * ║  my = reshape(MY, [Mx*My, 1])     ║  // combination of (mx, my) exactly    ║
  72:PhysPlateReverb.cpp ****  * ║  % Flatten to column vectors.     ║  // like meshgrid+reshape does.        ║
  73:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  74:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  75:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  76:PhysPlateReverb.cpp ****  * ║  idx = (a > thresh)               ║  bool idx[N];                          ║
  77:PhysPlateReverb.cpp ****  * ║  % Logical index: 1 where true.   ║  for (int i = 0; i < N; i++)           ║
  78:PhysPlateReverb.cpp ****  * ║                                   ║      idx[i] = (a[i] > thresh);         ║
  79:PhysPlateReverb.cpp ****  * ║                                   ║  // Builds array of true/false flags.  ║
  80:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  81:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  82:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  83:PhysPlateReverb.cpp ****  * ║  b = nonzeros(a .* idx)           ║  int count = 0;                        ║
  84:PhysPlateReverb.cpp ****  * ║  % Remove zero entries, keeping   ║  for (int i = 0; i < N; i++)           ║
  85:PhysPlateReverb.cpp ****  * ║  % only values where idx == 1.    ║      if (idx[i])                       ║
  86:PhysPlateReverb.cpp ****  * ║  % Resulting vector is shorter.   ║          b[count++] = a[i];            ║
  87:PhysPlateReverb.cpp ****  * ║                                   ║  // "Compacts" the array: copies only  ║
  88:PhysPlateReverb.cpp ****  * ║                                   ║  // surviving elements into contiguous ║
  89:PhysPlateReverb.cpp ****  * ║                                   ║  // slots. count = new length.         ║
  90:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  91:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  92:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  93:PhysPlateReverb.cpp ****  * ║  b = a.^2                         ║  for (int i = 0; i < N; i++)           ║
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 17


  94:PhysPlateReverb.cpp ****  * ║  % Element-wise squaring.         ║      b[i] = a[i] * a[i];               ║
  95:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  96:PhysPlateReverb.cpp ****  * ╠═══════════════════════════════
  97:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
  98:PhysPlateReverb.cpp ****  * ║  sqrt(x)  (double precision)      ║  sqrtf(x)  (single-precision float)    ║
  99:PhysPlateReverb.cpp ****  * ║  sin(x)                           ║  sinf(x)                               ║
 100:PhysPlateReverb.cpp ****  * ║  log(x)                           ║  logf(x)                               ║
 101:PhysPlateReverb.cpp ****  * ║  % MATLAB defaults to double.     ║  // Daisy's ARM Cortex-M7 has a        ║
 102:PhysPlateReverb.cpp ****  * ║  % C++ float is fine for audio.   ║  // hardware float FPU — always use    ║
 103:PhysPlateReverb.cpp ****  * ║                                   ║  // the 'f' suffix functions.          ║
 104:PhysPlateReverb.cpp ****  * ║                                   ║                                        ║
 105:PhysPlateReverb.cpp ****  * ╚═══════════════════════════════
 106:PhysPlateReverb.cpp ****  *
 107:PhysPlateReverb.cpp ****  * OTHER KEY DIFFERENCES:
 108:PhysPlateReverb.cpp ****  *
 109:PhysPlateReverb.cpp ****  * 1) MATLAB arrays are 1-based, C++ arrays are 0-based.
 110:PhysPlateReverb.cpp ****  *    MATLAB: a(1) is the first element.
 111:PhysPlateReverb.cpp ****  *    C++:    a[0] is the first element.
 112:PhysPlateReverb.cpp ****  *
 113:PhysPlateReverb.cpp ****  * 2) MATLAB dynamically resizes vectors. C++ arrays are fixed-size.
 114:PhysPlateReverb.cpp ****  *    We pre-allocate MAX_MODES slots and track the actual count in
 115:PhysPlateReverb.cpp ****  *    num_modes_.
 116:PhysPlateReverb.cpp ****  *
 117:PhysPlateReverb.cpp ****  * 3) MATLAB 'find()' returns indices matching a condition.
 118:PhysPlateReverb.cpp ****  *    C++: we use a for-loop with an if-statement instead.
 119:PhysPlateReverb.cpp ****  *
 120:PhysPlateReverb.cpp ****  * 4) In MATLAB, the entire sample loop runs offline on a pre-built
 121:PhysPlateReverb.cpp ****  *    impulse. Here, we process ONE sample at a time inside an audio
 122:PhysPlateReverb.cpp ****  *    callback that the hardware calls 48000 times/second.
 123:PhysPlateReverb.cpp ****  *
 124:PhysPlateReverb.cpp ****  * ===========================================================================
 125:PhysPlateReverb.cpp ****  */
 126:PhysPlateReverb.cpp **** 
 127:PhysPlateReverb.cpp **** #include "daisy_patch_sm.h"
 128:PhysPlateReverb.cpp **** #include "daisysp-lgpl.h"       // provides fmap(), Mapping::LOG
 129:PhysPlateReverb.cpp **** #include "planter.h"
 130:PhysPlateReverb.cpp **** #include <cmath>                // sqrtf, sinf, logf, fabsf, powf
 131:PhysPlateReverb.cpp **** #include <cstring>              // memset
 132:PhysPlateReverb.cpp **** 
 133:PhysPlateReverb.cpp **** using namespace daisy;
 134:PhysPlateReverb.cpp **** using namespace patch_sm;
 135:PhysPlateReverb.cpp **** using namespace daisysp;
 136:PhysPlateReverb.cpp **** using namespace anachrome;
 137:PhysPlateReverb.cpp **** 
 138:PhysPlateReverb.cpp **** /* -----------------------------------------------------------------------
 139:PhysPlateReverb.cpp ****  * PI_F is already #defined in DaisySP/Source/Utility/dsp.h as
 140:PhysPlateReverb.cpp ****  * 3.1415927410125732421875f — we just use it directly, no redefinition.
 141:PhysPlateReverb.cpp ****  * -----------------------------------------------------------------------*/
 142:PhysPlateReverb.cpp **** 
 143:PhysPlateReverb.cpp **** 
 144:PhysPlateReverb.cpp **** /* ========================================================================
 145:PhysPlateReverb.cpp ****  * SECTION 1 — Physical Constants
 146:PhysPlateReverb.cpp ****  *
 147:PhysPlateReverb.cpp ****  * MATLAB equivalent: the block of scalar variable assignments at the
 148:PhysPlateReverb.cpp ****  * top of the script.  In C++ these are compile-time constants
 149:PhysPlateReverb.cpp ****  * (constexpr), which means they cost zero RAM and are baked straight
 150:PhysPlateReverb.cpp ****  * into the compiled machine code.
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 18


 151:PhysPlateReverb.cpp ****  * ========================================================================*/
 152:PhysPlateReverb.cpp **** 
 153:PhysPlateReverb.cpp **** /* --- Plate geometry & material ---
 154:PhysPlateReverb.cpp ****  * MATLAB:
 155:PhysPlateReverb.cpp ****  *   Lx = 1;  Ly = 2;  H = 50e-4;  T = 100;  rho = 7.87e3;
 156:PhysPlateReverb.cpp ****  *   E = 200e9;  v = 0.29;
 157:PhysPlateReverb.cpp ****  */
 158:PhysPlateReverb.cpp **** static constexpr float LX      = 1.0f;       // plate x dimension [m]
 159:PhysPlateReverb.cpp **** static constexpr float LY      = 2.0f;       // plate y dimension [m]
 160:PhysPlateReverb.cpp **** static constexpr float H       = 8e-4f;     // thickness [m]  (= 0.5 mm)
 161:PhysPlateReverb.cpp **** static constexpr float TENSION = 700.0f;     // tension [N/m]
 162:PhysPlateReverb.cpp **** static constexpr float RHO     = 7.87e3f;    // density [kg/m³]  (steel)
 163:PhysPlateReverb.cpp **** static constexpr float E_MOD   = 200e9f;     // Young's modulus [N/m²]
 164:PhysPlateReverb.cpp **** static constexpr float NU      = 0.29f;      // Poisson's ratio
 165:PhysPlateReverb.cpp **** 
 166:PhysPlateReverb.cpp **** /* --- Input / output positions on the plate surface ---
 167:PhysPlateReverb.cpp ****  * MATLAB:  xi = 0.5; yi = 0.5; xo = 0.75; yo = 0.75;
 168:PhysPlateReverb.cpp ****  *
 169:PhysPlateReverb.cpp ****  * For STEREO output we define TWO pickup positions — this is how real
 170:PhysPlateReverb.cpp ****  * plate reverbs work: one plate, one driver (input), two contact mics
 171:PhysPlateReverb.cpp ****  * (outputs) placed at different spots to produce natural stereo.
 172:PhysPlateReverb.cpp ****  */
 173:PhysPlateReverb.cpp **** static constexpr float XI   = 0.5f;    // input (driver) x position [m]
 174:PhysPlateReverb.cpp **** static constexpr float YI   = 0.5f;    // input y position [m]
 175:PhysPlateReverb.cpp **** static constexpr float XO_L = 0.3f;    // LEFT  pickup x position [m]
 176:PhysPlateReverb.cpp **** static constexpr float YO_L = 0.7f;    // LEFT  pickup y position [m]
 177:PhysPlateReverb.cpp **** static constexpr float XO_R = 0.8f;    // RIGHT pickup x position [m]
 178:PhysPlateReverb.cpp **** static constexpr float YO_R = 0.4f;    // RIGHT pickup y position [m]
 179:PhysPlateReverb.cpp **** 
 180:PhysPlateReverb.cpp **** /* --- Mode pruning thresholds ---
 181:PhysPlateReverb.cpp ****  * MATLAB:  cent_range = 5; damp_thresh = .5; phi_thresh = 1e-5;
 182:PhysPlateReverb.cpp ****  */
 183:PhysPlateReverb.cpp **** static constexpr float CENT_RANGE  = 8.0f;    // frequency window [cents] (larger = stronger prunin
 184:PhysPlateReverb.cpp **** static constexpr float DAMP_THRESH = 0.5f;    // damping proximity fraction
 185:PhysPlateReverb.cpp **** static constexpr float PHI_THRESH  = 1e-5f;   // mode shape amplitude floor
 186:PhysPlateReverb.cpp **** 
 187:PhysPlateReverb.cpp **** /* --- Runtime stability / output scaling --- */
 188:PhysPlateReverb.cpp **** static constexpr float WET_TRIM     = 0.22f;   // global wet attenuation after modal sum
 189:PhysPlateReverb.cpp **** static constexpr float OUTPUT_LIMIT = 0.98f;   // safety clamp for Daisy audio output
 190:PhysPlateReverb.cpp **** static constexpr float OUT_NORM_BLEND = 0.20f; // 0=ignore normalization, 1=full normalization
 191:PhysPlateReverb.cpp **** static constexpr float WET_MAKEUP   = 1.0f;   // post-normalization wet makeup gain
 192:PhysPlateReverb.cpp **** static constexpr float MIX_HEADROOM = 0.85f;   // dry+wet pre-limiter headroom
 193:PhysPlateReverb.cpp **** static constexpr float INPUT_TRIM   = 0.55f;   // front-end trim for both dry and wet paths
 194:PhysPlateReverb.cpp **** static constexpr float DRY_MAX      = 0.75f;   // max dry contribution from knob
 195:PhysPlateReverb.cpp **** static constexpr float WET_SEND_MAX = 0.06f;   // conservative max excitation send
 196:PhysPlateReverb.cpp **** static constexpr float WET_MIX_MAX  = 0.85f;   // max wet return mix into output
 197:PhysPlateReverb.cpp **** static constexpr float WET_SEND_PRETRIM = 0.30f; // additional pre-reverb send trim
 198:PhysPlateReverb.cpp **** static constexpr float SEND_HPF_MIN_HZ = 10.0f;  // KNOB_5 minimum send HPF cutoff
 199:PhysPlateReverb.cpp **** static constexpr float SEND_HPF_MAX_HZ = 100.0f; // KNOB_5 maximum send HPF cutoff
 200:PhysPlateReverb.cpp **** static constexpr float WET_HPF_HZ   = 120.0f;  // remove sub buildup from wet return
 201:PhysPlateReverb.cpp **** 
 202:PhysPlateReverb.cpp **** /* --- Memory budgets ---
 203:PhysPlateReverb.cpp ****  * In MATLAB, vectors grow dynamically.  In C++ on embedded hardware we
 204:PhysPlateReverb.cpp ****  * must pre-allocate fixed-size arrays.  These constants set the limits.
 205:PhysPlateReverb.cpp ****  */
 206:PhysPlateReverb.cpp **** static constexpr int MAX_RAW_MODES = 12000;   // prior to pruning
