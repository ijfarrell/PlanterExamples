 267:PhysPlateReverb.cpp ****      * MATLAB equivalent: everything from "derived parameters" down to
 268:PhysPlateReverb.cpp ****      * the coefficient computation (B, C, D), NOT including the sample
 269:PhysPlateReverb.cpp ****      * loop.
 270:PhysPlateReverb.cpp ****      * -------------------------------------------------------------------*/
 271:PhysPlateReverb.cpp ****     void Init(float sample_rate);
 272:PhysPlateReverb.cpp **** 
 273:PhysPlateReverb.cpp ****     /* -------------------------------------------------------------------
 274:PhysPlateReverb.cpp ****      * UpdateDecay()
 275:PhysPlateReverb.cpp ****      *
 276:PhysPlateReverb.cpp ****      * Recalculate damping coefficients from new T60 values.
 277:PhysPlateReverb.cpp ****      * Called once per audio block when the decay knobs change.
 278:PhysPlateReverb.cpp ****      *
 279:PhysPlateReverb.cpp ****      * MATLAB equivalent: recomputing sig_0, sig_1, sigma, B, C, D with
 280:PhysPlateReverb.cpp ****      * new T60_low / T60_high values.
 281:PhysPlateReverb.cpp ****      * -------------------------------------------------------------------*/
 282:PhysPlateReverb.cpp ****     void UpdateDecay(float t60_low, float t60_high);
 283:PhysPlateReverb.cpp **** 
 284:PhysPlateReverb.cpp ****     /* -------------------------------------------------------------------
 285:PhysPlateReverb.cpp ****      * ProcessStereo()
 286:PhysPlateReverb.cpp ****      *
 287:PhysPlateReverb.cpp ****      * Process ONE audio sample through the modal plate.
 288:PhysPlateReverb.cpp ****      * Returns stereo output via pointers (two pickup positions).
 289:PhysPlateReverb.cpp ****      *
 290:PhysPlateReverb.cpp ****      * MATLAB equivalent: ONE iteration of the "for n = 1:Nf" loop:
 291:PhysPlateReverb.cpp ****      *   p0      = B.*p1 + C.*p2 + D*in1(n);
 292:PhysPlateReverb.cpp ****      *   out1(n) = sum(phi_o_new .* p0);
 293:PhysPlateReverb.cpp ****      *   p2 = p1;  p1 = p0;
 294:PhysPlateReverb.cpp ****      * -------------------------------------------------------------------*/
 295:PhysPlateReverb.cpp ****     void ProcessStereo(float input, float* out_l, float* out_r);
 296:PhysPlateReverb.cpp **** 
 297:PhysPlateReverb.cpp ****     void ProcessMono(float input, float* out_mono);
 298:PhysPlateReverb.cpp **** 
 299:PhysPlateReverb.cpp ****     /* How many modes survived pruning? (informational) */
 300:PhysPlateReverb.cpp ****     int GetModeCount() const { return num_modes_; }
 301:PhysPlateReverb.cpp **** 
 302:PhysPlateReverb.cpp **** private:
 303:PhysPlateReverb.cpp ****     int   num_modes_;   // actual mode count after pruning (≤ MAX_MODES)
 304:PhysPlateReverb.cpp ****     float k_;           // sample period = 1/SR                      [seconds]
 305:PhysPlateReverb.cpp ****     float k_sq_;        // k² (pre-computed, used in B coefficient)
 306:PhysPlateReverb.cpp **** 
 307:PhysPlateReverb.cpp ****     /* --- Per-mode data (FIXED after Init — geometry-dependent) ---
 308:PhysPlateReverb.cpp ****      *
 309:PhysPlateReverb.cpp ****      *  MATLAB variable  →  C++ array        meaning
 310:PhysPlateReverb.cpp ****      *  ───────────────     ──────────        ─
 311:PhysPlateReverb.cpp ****      *  omega_new         → omega_[]         modal angular frequencies [rad/s]
 312:PhysPlateReverb.cpp ****      *  beta_stable.^2    → beta_sq_[]       wavenumber² (for recomputing σ)
 313:PhysPlateReverb.cpp ****      *  phi_i_new         → phi_i_[]         mode shape at input position
 314:PhysPlateReverb.cpp ****      *  phi_o_new         → phi_o_l_[]       mode shape at LEFT  pickup
 315:PhysPlateReverb.cpp ****      *                      phi_o_r_[]       mode shape at RIGHT pickup
 316:PhysPlateReverb.cpp ****      */
 317:PhysPlateReverb.cpp ****     float omega_[MAX_MODES];
 318:PhysPlateReverb.cpp ****     float beta_sq_[MAX_MODES];
 319:PhysPlateReverb.cpp ****     float phi_i_[MAX_MODES];
 320:PhysPlateReverb.cpp ****     float phi_o_l_[MAX_MODES];
 321:PhysPlateReverb.cpp ****     float phi_o_r_[MAX_MODES];
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 21


 322:PhysPlateReverb.cpp ****     float phi_o_m_[MAX_MODES];
 323:PhysPlateReverb.cpp **** 
 324:PhysPlateReverb.cpp ****     /* --- Per-mode coefficients (RECOMPUTED when T60 knobs change) ---
 325:PhysPlateReverb.cpp ****      *
 326:PhysPlateReverb.cpp ****      *  MATLAB:                              C++ array:
 327:PhysPlateReverb.cpp ****      *  B = (2 - k²ω²) / (1+σk)          → B_[]
 328:PhysPlateReverb.cpp ****      *  C = (σk - 1)    / (1+σk)          → C_[]
 329:PhysPlateReverb.cpp ****      *  D = φ_i         / (1+σk)          → D_[]
 330:PhysPlateReverb.cpp ****      *
 331:PhysPlateReverb.cpp ****      *  These are the "weights" in the per-sample state-update equation.
 332:PhysPlateReverb.cpp ****      *  Recomputing them per audio block (~1 ms) lets us change the
 333:PhysPlateReverb.cpp ****      *  reverb time in real time without a full re-init.
 334:PhysPlateReverb.cpp ****      */
 335:PhysPlateReverb.cpp ****     float B_[MAX_MODES];
 336:PhysPlateReverb.cpp ****     float C_[MAX_MODES];
 337:PhysPlateReverb.cpp ****     float D_[MAX_MODES];
 338:PhysPlateReverb.cpp **** 
 339:PhysPlateReverb.cpp ****     /* --- Per-mode STATE vectors (persist between audio callbacks) ---
 340:PhysPlateReverb.cpp ****      *
 341:PhysPlateReverb.cpp ****      *  MATLAB: p1 = zeros(sp_len,1);  p2 = zeros(sp_len,1);
 342:PhysPlateReverb.cpp ****      *
 343:PhysPlateReverb.cpp ****      *  p1 = current  state (P^n)       — the "position" of each mode
 344:PhysPlateReverb.cpp ****      *  p2 = previous state (P^{n-1})   — needed for the 2nd-order update
 345:PhysPlateReverb.cpp ****      *
 346:PhysPlateReverb.cpp ****      *  In MATLAB these are Nx1 column vectors.  In C++ they are plain
 347:PhysPlateReverb.cpp ****      *  float arrays of length MAX_MODES.  Only the first num_modes_
 348:PhysPlateReverb.cpp ****      *  entries are used.
 349:PhysPlateReverb.cpp ****      */
 350:PhysPlateReverb.cpp ****     float p1_[MAX_MODES];
 351:PhysPlateReverb.cpp ****     float p2_[MAX_MODES];
 352:PhysPlateReverb.cpp **** 
 353:PhysPlateReverb.cpp ****     /* Cached beta² range for real-time sigma recomputation */
 354:PhysPlateReverb.cpp ****     float beta_sq_min_;
 355:PhysPlateReverb.cpp ****     float beta_sq_max_;
 356:PhysPlateReverb.cpp **** 
 357:PhysPlateReverb.cpp ****     /* Per-channel pickup normalization to reduce excessive modal sum gain */
 358:PhysPlateReverb.cpp ****     float out_norm_l_;
 359:PhysPlateReverb.cpp ****     float out_norm_r_;
 360:PhysPlateReverb.cpp ****     float out_norm_m_;
 361:PhysPlateReverb.cpp **** };
 362:PhysPlateReverb.cpp **** 
 363:PhysPlateReverb.cpp **** 
 364:PhysPlateReverb.cpp **** /* ========================================================================
 365:PhysPlateReverb.cpp ****  * SECTION 4 — Init() Implementation
 366:PhysPlateReverb.cpp ****  *
 367:PhysPlateReverb.cpp ****  * This function does ALL the pre-processing that the MATLAB script does
 368:PhysPlateReverb.cpp ****  * before its sample loop, in the same order:
 369:PhysPlateReverb.cpp ****  *   1. Derive physical constants (κ, c, ω_max, β_max)
 370:PhysPlateReverb.cpp ****  *   2. Determine max mode indices Mx, My
 371:PhysPlateReverb.cpp ****  *   3. Loop over all (mx, my) pairs → stability check → store raw modes
 372:PhysPlateReverb.cpp ****  *   4. Compute initial σ (damping) for the pruning step
 373:PhysPlateReverb.cpp ****  *   5. Prune modes (frequency/damping proximity + mode shape threshold)
 374:PhysPlateReverb.cpp ****  *   6. Compact surviving modes into final arrays ("nonzeros" in MATLAB)
 375:PhysPlateReverb.cpp ****  *   7. Zero the state vectors
 376:PhysPlateReverb.cpp ****  *   8. Compute initial B, C, D coefficients
 377:PhysPlateReverb.cpp ****  * ========================================================================*/
 378:PhysPlateReverb.cpp **** void ModalPlateReverb::Init(float sample_rate)
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 22


 379:PhysPlateReverb.cpp **** {
 380:PhysPlateReverb.cpp ****     num_modes_ = 0;
 381:PhysPlateReverb.cpp ****     out_norm_l_ = 1.0f;
 382:PhysPlateReverb.cpp ****     out_norm_r_ = 1.0f;
 383:PhysPlateReverb.cpp ****     out_norm_m_ = 1.0f;
 384:PhysPlateReverb.cpp **** 
 385:PhysPlateReverb.cpp ****     /* ===== Step 1: Derived constants =====================================
 386:PhysPlateReverb.cpp ****      *
 387:PhysPlateReverb.cpp ****      * MATLAB:
 388:PhysPlateReverb.cpp ****      *   k = 1/SR;
 389:PhysPlateReverb.cpp ****      *   K = sqrt( E*(H^2) / ( 12*rho*(1-v^2) ) );
 390:PhysPlateReverb.cpp ****      *   c = sqrt( T/(rho*H) );
 391:PhysPlateReverb.cpp ****      *   omega_max = 2/k;
 392:PhysPlateReverb.cpp ****      *   beta_max  = sqrt((-c^2 + sqrt(c^4 + 4*omega_max^2*K^2)) / (2*K^2));
 393:PhysPlateReverb.cpp ****      *
 394:PhysPlateReverb.cpp ****      * In C++ these are local variables computed once at startup.
 395:PhysPlateReverb.cpp ****      * Note: we use sqrtf() instead of sqrt() for single-precision.
 396:PhysPlateReverb.cpp ****      * ====================================================================*/
 397:PhysPlateReverb.cpp **** 
 398:PhysPlateReverb.cpp ****     // k = 1/SR  →  sample period in seconds
 399:PhysPlateReverb.cpp ****     k_    = 1.0f / sample_rate;
 400:PhysPlateReverb.cpp ****     k_sq_ = k_ * k_;
 401:PhysPlateReverb.cpp **** 
 402:PhysPlateReverb.cpp ****     // kappa (κ) — stiffness parameter
 403:PhysPlateReverb.cpp ****     // MATLAB: K = sqrt( E*(H^2) / (12*rho*(1-v^2)) )
 404:PhysPlateReverb.cpp ****     const float kappa = sqrtf(E_MOD * (H * H)
 405:PhysPlateReverb.cpp ****                               / (12.0f * RHO * (1.0f - NU * NU)));
 406:PhysPlateReverb.cpp **** 
 407:PhysPlateReverb.cpp ****     // c — wave speed on the plate
 408:PhysPlateReverb.cpp ****     // MATLAB: c = sqrt( T/(rho*H) )
 409:PhysPlateReverb.cpp ****     const float c = sqrtf(TENSION / (RHO * H));
 410:PhysPlateReverb.cpp **** 
 411:PhysPlateReverb.cpp ****     // omega_max — maximum modal frequency that can be represented
 412:PhysPlateReverb.cpp ****     // at this sample rate (Nyquist-related stability limit)
 413:PhysPlateReverb.cpp ****     // MATLAB: omega_max = 2/k
 414:PhysPlateReverb.cpp ****     const float omega_max = 2.0f / k_;
 415:PhysPlateReverb.cpp **** 
 416:PhysPlateReverb.cpp ****     // beta_max — maximum wavenumber for stable modes
 417:PhysPlateReverb.cpp ****     // MATLAB: beta_max = sqrt((-c^2 + sqrt(c^4 + 4*omega_max^2*K^2)) / (2*K^2))
 418:PhysPlateReverb.cpp ****     const float c2 = c * c;     // c squared
 419:PhysPlateReverb.cpp ****     const float K2 = kappa * kappa;  // κ squared
 420:PhysPlateReverb.cpp ****     const float beta_max = sqrtf(
 421:PhysPlateReverb.cpp ****         (-c2 + sqrtf(c2 * c2 + 4.0f * omega_max * omega_max * K2))
 422:PhysPlateReverb.cpp ****         / (2.0f * K2)
 423:PhysPlateReverb.cpp ****     );
 424:PhysPlateReverb.cpp **** 
 425:PhysPlateReverb.cpp **** 
 426:PhysPlateReverb.cpp ****     /* ===== Step 2: Maximum mode indices ==================================
 427:PhysPlateReverb.cpp ****      *
 428:PhysPlateReverb.cpp ****      * MATLAB:
 429:PhysPlateReverb.cpp ****      *   Mx = floor(sqrt( ((Lx*Ly*beta_max)^2 - (pi*Lx)^2) / (pi*Ly)^2 ));
 430:PhysPlateReverb.cpp ****      *   My = floor(sqrt( ((Lx*Ly*beta_max)^2 - (pi*Ly)^2) / (pi*Lx)^2 ));
 431:PhysPlateReverb.cpp ****      *
 432:PhysPlateReverb.cpp ****      * These determine how many modes to check in x and y.  Casting to
 433:PhysPlateReverb.cpp ****      * int is the C++ equivalent of floor() for positive values.
 434:PhysPlateReverb.cpp ****      * ====================================================================*/
 435:PhysPlateReverb.cpp ****     const float LxLy_beta_sq = (LX * LY * beta_max) * (LX * LY * beta_max);
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 23


 436:PhysPlateReverb.cpp ****     const float piLx_sq      = (PI_F * LX) * (PI_F * LX);
 437:PhysPlateReverb.cpp ****     const float piLy_sq      = (PI_F * LY) * (PI_F * LY);
 438:PhysPlateReverb.cpp **** 
 439:PhysPlateReverb.cpp ****     // (int) truncates toward zero = floor for positive numbers
 440:PhysPlateReverb.cpp ****     int Mx = (int)sqrtf((LxLy_beta_sq - piLx_sq) / piLy_sq);
 441:PhysPlateReverb.cpp ****     int My = (int)sqrtf((LxLy_beta_sq - piLy_sq) / piLx_sq);
 442:PhysPlateReverb.cpp **** 
 443:PhysPlateReverb.cpp **** 
 444:PhysPlateReverb.cpp ****     /* ===== Step 3: Generate all modes ====================================
 445:PhysPlateReverb.cpp ****      *
 446:PhysPlateReverb.cpp ****      * MATLAB:
 447:PhysPlateReverb.cpp ****      *   [MX,MY] = meshgrid(1:Mx, 1:My);
 448:PhysPlateReverb.cpp ****      *   mx = reshape(MX, [Mx*My, 1]);
 449:PhysPlateReverb.cpp ****      *   my = reshape(MY, [Mx*My, 1]);
 450:PhysPlateReverb.cpp ****      *   beta = sqrt( (mx*pi/Lx).^2 + (my*pi/Ly).^2 );
 451:PhysPlateReverb.cpp ****      *   stab_index = beta < beta_max;
 452:PhysPlateReverb.cpp ****      *   beta_stable = nonzeros(beta .* stab_index);
 453:PhysPlateReverb.cpp ****      *   omega = sqrt( c^2*beta_stable.^2 + K^2*beta_stable.^4 );
 454:PhysPlateReverb.cpp ****      *   phi_i = (2/sqrt(Lx*Ly)) * sin(mx*xi*pi/Lx) .* sin(my*yi*pi/Ly);
 455:PhysPlateReverb.cpp ****      *   phi_o = (2/sqrt(Lx*Ly)) * sin(mx*xo*pi/Lx) .* sin(my*yo*pi/Ly);
 456:PhysPlateReverb.cpp ****      *
 457:PhysPlateReverb.cpp ****      * C++ TRANSLATION:
 458:PhysPlateReverb.cpp ****      * ────────────────
 459:PhysPlateReverb.cpp ****      * meshgrid + reshape is replaced by a NESTED FOR LOOP.  Each (mx, my)
 460:PhysPlateReverb.cpp ****      * pair produces one mode.  We immediately check stability (beta < beta_max)
 461:PhysPlateReverb.cpp ****      * and skip unstable modes — this replaces the stab_index / nonzeros
 462:PhysPlateReverb.cpp ****      * pattern in MATLAB.
 463:PhysPlateReverb.cpp ****      *
 464:PhysPlateReverb.cpp ****      * The mode shape normalization factor 2/sqrt(Lx*Ly) is a scalar that
 465:PhysPlateReverb.cpp ****      * MATLAB broadcasts across the whole vector; in C++ we just multiply
 466:PhysPlateReverb.cpp ****      * it in for each element.
 467:PhysPlateReverb.cpp ****      *
 468:PhysPlateReverb.cpp ****      * We store surviving modes into the raw_* temporary arrays.
 469:PhysPlateReverb.cpp ****      * ====================================================================*/
 470:PhysPlateReverb.cpp **** 
 471:PhysPlateReverb.cpp ****     // MATLAB: 2/sqrt(Lx*Ly)  — mode shape normalization
 472:PhysPlateReverb.cpp ****     const float phi_norm = 2.0f / sqrtf(LX * LY);
 473:PhysPlateReverb.cpp **** 
 474:PhysPlateReverb.cpp ****     int raw_count = 0;  // number of modes that pass the stability check
 475:PhysPlateReverb.cpp **** 
 476:PhysPlateReverb.cpp ****     // ----- NESTED LOOP = meshgrid(1:Mx, 1:My) + reshape -----
 477:PhysPlateReverb.cpp ****     // mx is the outer loop (changes slowly)
 478:PhysPlateReverb.cpp ****     // my is the inner loop (changes quickly)
 479:PhysPlateReverb.cpp ****     // → same ordering as MATLAB's column-major reshape
 480:PhysPlateReverb.cpp ****     for (int mx = 1; mx <= Mx; mx++)
 481:PhysPlateReverb.cpp ****     {
 482:PhysPlateReverb.cpp ****         for (int my = 1; my <= My; my++)
 483:PhysPlateReverb.cpp ****         {
 484:PhysPlateReverb.cpp ****             // ----- Wavenumber (beta) -----
 485:PhysPlateReverb.cpp ****             // MATLAB: beta = sqrt( (mx*pi/Lx)^2 + (my*pi/Ly)^2 )
 486:PhysPlateReverb.cpp ****             //
 487:PhysPlateReverb.cpp ****             // In MATLAB this is one vectorized line operating on all modes.
 488:PhysPlateReverb.cpp ****             // In C++ we compute it for one (mx, my) pair per iteration.
 489:PhysPlateReverb.cpp ****             float bx   = (float)mx * PI_F / LX;   // x-direction component
 490:PhysPlateReverb.cpp ****             float by   = (float)my * PI_F / LY;   // y-direction component
 491:PhysPlateReverb.cpp ****             float beta = sqrtf(bx * bx + by * by); // total wavenumber
 492:PhysPlateReverb.cpp **** 
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 24


 493:PhysPlateReverb.cpp ****             // ----- Stability check -----
 494:PhysPlateReverb.cpp ****             // MATLAB: stab_index = beta < beta_max;
 495:PhysPlateReverb.cpp ****             // Only keep modes whose wavenumber is below the Nyquist limit.
 496:PhysPlateReverb.cpp ****             // In MATLAB this creates a logical vector; here we just skip.
 497:PhysPlateReverb.cpp ****             if (beta >= beta_max)
 498:PhysPlateReverb.cpp ****                 continue;   // unstable → skip this (mx,my) pair
 499:PhysPlateReverb.cpp **** 
 500:PhysPlateReverb.cpp ****             // Guard: don't overflow our pre-allocated buffer
 501:PhysPlateReverb.cpp ****             if (raw_count >= MAX_RAW_MODES)
 502:PhysPlateReverb.cpp ****                 break;
 503:PhysPlateReverb.cpp **** 
 504:PhysPlateReverb.cpp ****             float beta_sq = beta * beta;   // β² — reused several times
 505:PhysPlateReverb.cpp **** 
 506:PhysPlateReverb.cpp ****             // ----- Modal angular frequency -----
 507:PhysPlateReverb.cpp ****             // MATLAB: omega = sqrt( c^2 * beta.^2 + K^2 * beta.^4 )
 508:PhysPlateReverb.cpp ****             //
 509:PhysPlateReverb.cpp ****             // beta.^2 is element-wise squaring of the beta vector.
 510:PhysPlateReverb.cpp ****             // In C++ we already have beta_sq for this one mode.
 511:PhysPlateReverb.cpp ****             float omega = sqrtf(c2 * beta_sq + K2 * beta_sq * beta_sq);
 512:PhysPlateReverb.cpp **** 
 513:PhysPlateReverb.cpp ****             // ----- Mode shapes at input position -----
 514:PhysPlateReverb.cpp ****             // MATLAB: phi_i = (2/sqrt(Lx*Ly)) * sin(mx*xi*pi/Lx) .* sin(my*yi*pi/Ly)
 515:PhysPlateReverb.cpp ****             //
 516:PhysPlateReverb.cpp ****             // .* is element-wise multiply of two sin() vectors.
 517:PhysPlateReverb.cpp ****             // In C++ we compute the scalar product of two single sin values.
 518:PhysPlateReverb.cpp ****             float phi_i = phi_norm
 519:PhysPlateReverb.cpp ****                           * sinf((float)mx * XI * PI_F / LX)
 520:PhysPlateReverb.cpp ****                           * sinf((float)my * YI * PI_F / LY);
 521:PhysPlateReverb.cpp **** 
 522:PhysPlateReverb.cpp ****             // ----- Mode shapes at LEFT output position -----
 523:PhysPlateReverb.cpp ****             float phi_o_l = phi_norm
 524:PhysPlateReverb.cpp ****                             * sinf((float)mx * XO_L * PI_F / LX)
 525:PhysPlateReverb.cpp ****                             * sinf((float)my * YO_L * PI_F / LY);
 526:PhysPlateReverb.cpp **** 
 527:PhysPlateReverb.cpp ****             // ----- Mode shapes at RIGHT output position -----
 528:PhysPlateReverb.cpp ****             float phi_o_r = phi_norm
 529:PhysPlateReverb.cpp ****                             * sinf((float)mx * XO_R * PI_F / LX)
 530:PhysPlateReverb.cpp ****                             * sinf((float)my * YO_R * PI_F / LY);
 531:PhysPlateReverb.cpp **** 
 532:PhysPlateReverb.cpp ****             // Store this mode into the temporary arrays
 533:PhysPlateReverb.cpp ****             // (like building up the MATLAB vectors one element at a time)
 534:PhysPlateReverb.cpp ****             raw_omega[raw_count]   = omega;
 535:PhysPlateReverb.cpp ****             raw_beta_sq[raw_count] = beta_sq;
 536:PhysPlateReverb.cpp ****             raw_phi_i[raw_count]   = phi_i;
 537:PhysPlateReverb.cpp ****             raw_phi_o_l[raw_count] = phi_o_l;
 538:PhysPlateReverb.cpp ****             raw_phi_o_r[raw_count] = phi_o_r;
 539:PhysPlateReverb.cpp ****             raw_count++;
 540:PhysPlateReverb.cpp ****         }
 541:PhysPlateReverb.cpp ****         // Also guard the outer loop
 542:PhysPlateReverb.cpp ****         if (raw_count >= MAX_RAW_MODES)
 543:PhysPlateReverb.cpp ****             break;
 544:PhysPlateReverb.cpp ****     }
 545:PhysPlateReverb.cpp **** 
 546:PhysPlateReverb.cpp **** 
 547:PhysPlateReverb.cpp ****     /* ===== Step 4: Compute σ (damping) for the pruning step ==============
 548:PhysPlateReverb.cpp ****      *
 549:PhysPlateReverb.cpp ****      * MATLAB:
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 25


 550:PhysPlateReverb.cpp ****      *   sig_0 = ((6*log(10)) / (max(β²) - min(β²)))
 551:PhysPlateReverb.cpp ****      *           * ((max(β²)/T60_low) - (min(β²)/T60_high));
 552:PhysPlateReverb.cpp ****      *   sig_1 = ((6*log(10)) / (max(β²) - min(β²)))
 553:PhysPlateReverb.cpp ****      *           * (1/T60_high - 1/T60_low);
 554:PhysPlateReverb.cpp ****      *   sigma = sig_0 + sig_1 * beta_stable.^2;
 555:PhysPlateReverb.cpp ****      *
 556:PhysPlateReverb.cpp ****      * MATLAB: max() and min() scan the entire vector in one call.
 557:PhysPlateReverb.cpp ****      * C++ TRANSLATION: a for-loop that tracks the running min/max.
 558:PhysPlateReverb.cpp ****      *
 559:PhysPlateReverb.cpp ****      * We need sigma for the pruning comparisons.  After pruning, we'll
 560:PhysPlateReverb.cpp ****      * recompute sigma from the knob-controlled T60 values.
 561:PhysPlateReverb.cpp ****      * ====================================================================*/
 562:PhysPlateReverb.cpp **** 
 563:PhysPlateReverb.cpp ****     if(raw_count <= 0)
 564:PhysPlateReverb.cpp ****     {
 565:PhysPlateReverb.cpp ****         memset(p1_, 0, sizeof(p1_));
 566:PhysPlateReverb.cpp ****         memset(p2_, 0, sizeof(p2_));
 567:PhysPlateReverb.cpp ****         return;
 568:PhysPlateReverb.cpp ****     }
 569:PhysPlateReverb.cpp **** 
 570:PhysPlateReverb.cpp ****     // Find min and max of β²
 571:PhysPlateReverb.cpp ****     // MATLAB: max(beta_stable)^2 and min(beta_stable)^2
 572:PhysPlateReverb.cpp ****     float bsq_min = raw_beta_sq[0];
 573:PhysPlateReverb.cpp ****     float bsq_max = raw_beta_sq[0];
 574:PhysPlateReverb.cpp ****     for (int i = 1; i < raw_count; i++)
 575:PhysPlateReverb.cpp ****     {
 576:PhysPlateReverb.cpp ****         if (raw_beta_sq[i] < bsq_min) bsq_min = raw_beta_sq[i];
 577:PhysPlateReverb.cpp ****         if (raw_beta_sq[i] > bsq_max) bsq_max = raw_beta_sq[i];
 578:PhysPlateReverb.cpp ****     }
 579:PhysPlateReverb.cpp **** 
 580:PhysPlateReverb.cpp ****     // T60 values for the pruning pass (default — overridden later by knobs)
 581:PhysPlateReverb.cpp ****     const float t60_low_init  = 2.0f;    // T60 at lowest mode  [s]
 582:PhysPlateReverb.cpp ****     const float t60_high_init = 0.5f;    // T60 at highest mode [s]
 583:PhysPlateReverb.cpp **** 
 584:PhysPlateReverb.cpp ****     // 6 * ln(10) ≈ 13.8155 — appears in both sig_0 and sig_1
 585:PhysPlateReverb.cpp ****     const float six_ln10  = 6.0f * logf(10.0f);
 586:PhysPlateReverb.cpp **** 
 587:PhysPlateReverb.cpp ****     // Protect against degenerate case where all modes have same beta
 588:PhysPlateReverb.cpp ****     float bsq_range = bsq_max - bsq_min;
 589:PhysPlateReverb.cpp ****     if (bsq_range < 1e-10f) bsq_range = 1e-10f;
 590:PhysPlateReverb.cpp **** 
 591:PhysPlateReverb.cpp ****     // MATLAB: sig_0 = ((6*log(10))/(max(β²)-min(β²))) * ((max(β²)/T60_low) - (min(β²)/T60_
 592:PhysPlateReverb.cpp ****     float sig_0 = (six_ln10 / bsq_range)
 593:PhysPlateReverb.cpp ****                   * ((bsq_max / t60_low_init) - (bsq_min / t60_high_init));
 594:PhysPlateReverb.cpp **** 
 595:PhysPlateReverb.cpp ****     // MATLAB: sig_1 = ((6*log(10))/(max(β²)-min(β²))) * (1/T60_high - 1/T60_low)
 596:PhysPlateReverb.cpp ****     float sig_1 = (six_ln10 / bsq_range)
 597:PhysPlateReverb.cpp ****                   * (1.0f / t60_high_init - 1.0f / t60_low_init);
 598:PhysPlateReverb.cpp **** 
 599:PhysPlateReverb.cpp ****     // MATLAB: sigma = sig_0 + sig_1 * beta_stable.^2;
 600:PhysPlateReverb.cpp ****     //
 601:PhysPlateReverb.cpp ****     // This is a VECTOR operation in MATLAB — sig_0 is a scalar added to
 602:PhysPlateReverb.cpp ****     // every element, and sig_1 * beta.^2 is scalar-times-vector.
 603:PhysPlateReverb.cpp ****     // In C++ we loop and compute each element:
 604:PhysPlateReverb.cpp ****     for (int i = 0; i < raw_count; i++)
 605:PhysPlateReverb.cpp ****     {
 606:PhysPlateReverb.cpp ****         raw_sigma[i] = sig_0 + sig_1 * raw_beta_sq[i];
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 26


 607:PhysPlateReverb.cpp ****     }
 608:PhysPlateReverb.cpp **** 
 609:PhysPlateReverb.cpp **** 
 610:PhysPlateReverb.cpp ****     /* ===== Step 5: Mode Pruning ==========================================
 611:PhysPlateReverb.cpp ****      *
 612:PhysPlateReverb.cpp ****      * MATLAB:
 613:PhysPlateReverb.cpp ****      *   cent_thresh = cent_range * (2^(1/1200)-1);
 614:PhysPlateReverb.cpp ****      *   omega_new = omega;
 615:PhysPlateReverb.cpp ****      *   for m = 1:length(omega_new)
 616:PhysPlateReverb.cpp ****      *       if omega_new(m) == 0       ← skip already-pruned
 617:PhysPlateReverb.cpp ****      *       else
 618:PhysPlateReverb.cpp ****      *           if phi below threshold → omega_new(m) = 0
 619:PhysPlateReverb.cpp ****      *           else
 620:PhysPlateReverb.cpp ****      *               [row] = find(... modes within freq & damp window ...);
 621:PhysPlateReverb.cpp ****      *               omega_new(row) = 0;   ← prune neighbors
 622:PhysPlateReverb.cpp ****      *           end
 623:PhysPlateReverb.cpp ****      *       end
 624:PhysPlateReverb.cpp ****      *   end
 625:PhysPlateReverb.cpp ****      *   prunevec = omega_new ~= 0;
 626:PhysPlateReverb.cpp ****      *
 627:PhysPlateReverb.cpp ****      * C++ TRANSLATION:
 628:PhysPlateReverb.cpp ****      * ────────────────
 629:PhysPlateReverb.cpp ****      * MATLAB's find() returns a vector of indices matching a compound
 630:PhysPlateReverb.cpp ****      * boolean condition.  In C++ we replace it with a for-loop that
 631:PhysPlateReverb.cpp ****      * checks each condition with an if-statement.
 632:PhysPlateReverb.cpp ****      *
 633:PhysPlateReverb.cpp ****      * Instead of setting omega_new to 0, we maintain a separate integer
 634:PhysPlateReverb.cpp ****      * array raw_active[] where 1 = keep, 0 = pruned.  This is cleaner
 635:PhysPlateReverb.cpp ****      * than the MATLAB trick of zeroing out values then calling nonzeros().
 636:PhysPlateReverb.cpp ****      *
 637:PhysPlateReverb.cpp ****      * The pruning is "greedy": modes processed first get priority.
 638:PhysPlateReverb.cpp ****      * If mode m is still active, it prunes any NEIGHBOR modes that are
 639:PhysPlateReverb.cpp ****      * within both the frequency window AND the damping window.
 640:PhysPlateReverb.cpp ****      * ====================================================================*/
 641:PhysPlateReverb.cpp **** 
 642:PhysPlateReverb.cpp ****     // MATLAB: cent_thresh = cent_range * (2^(1/1200)-1)
 643:PhysPlateReverb.cpp ****     // This converts cents to a fractional frequency ratio.
 644:PhysPlateReverb.cpp ****     const float cent_thresh = CENT_RANGE * (powf(2.0f, 1.0f / 1200.0f) - 1.0f);
 645:PhysPlateReverb.cpp **** 
 646:PhysPlateReverb.cpp ****     // Initialize all modes as active (1 = keep)
 647:PhysPlateReverb.cpp ****     // MATLAB: omega_new = omega;  (copy — all nonzero = "active")
 648:PhysPlateReverb.cpp ****     for (int i = 0; i < raw_count; i++)
 649:PhysPlateReverb.cpp ****         raw_active[i] = 1;
 650:PhysPlateReverb.cpp **** 
 651:PhysPlateReverb.cpp ****     // ----- Main pruning loop -----
 652:PhysPlateReverb.cpp ****     // MATLAB: for m = 1:length(omega_new) ...
 653:PhysPlateReverb.cpp ****     //
 654:PhysPlateReverb.cpp ****     // NOTE: MATLAB is 1-indexed (starts at 1), C++ is 0-indexed (starts at 0).
 655:PhysPlateReverb.cpp ****     // The logic is identical; only the index origin differs.
 656:PhysPlateReverb.cpp ****     for (int m = 0; m < raw_count; m++)
 657:PhysPlateReverb.cpp ****     {
 658:PhysPlateReverb.cpp ****         // MATLAB: if omega_new(m) == 0 → skip
 659:PhysPlateReverb.cpp ****         // C++: check our active flag instead
 660:PhysPlateReverb.cpp ****         if (!raw_active[m])
 661:PhysPlateReverb.cpp ****             continue;   // already pruned by an earlier iteration — skip
 662:PhysPlateReverb.cpp **** 
 663:PhysPlateReverb.cpp ****         // ----- Check mode shape amplitudes -----
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 27


 664:PhysPlateReverb.cpp ****         // MATLAB: if abs(phi_o(m)) < phi_thresh || abs(phi_i(m)) < phi_thresh
 665:PhysPlateReverb.cpp ****         //             omega_new(m) = 0;
 666:PhysPlateReverb.cpp ****         //
 667:PhysPlateReverb.cpp ****         // If the mode has near-zero amplitude at either the input position
 668:PhysPlateReverb.cpp ****         // OR at BOTH output positions, it's inaudible → prune it.
 669:PhysPlateReverb.cpp ****         //
 670:PhysPlateReverb.cpp ****         // (For stereo: we keep the mode if it's audible on at least one
 671:PhysPlateReverb.cpp ****         //  output channel, which is why we use && for the two outputs.)
 672:PhysPlateReverb.cpp ****         if (fabsf(raw_phi_i[m]) < PHI_THRESH ||
 673:PhysPlateReverb.cpp ****             (fabsf(raw_phi_o_l[m]) < PHI_THRESH &&
 674:PhysPlateReverb.cpp ****              fabsf(raw_phi_o_r[m]) < PHI_THRESH))
 675:PhysPlateReverb.cpp ****         {
 676:PhysPlateReverb.cpp ****             raw_active[m] = 0;   // ← MATLAB: omega_new(m) = 0
 677:PhysPlateReverb.cpp ****             continue;
 678:PhysPlateReverb.cpp ****         }
 679:PhysPlateReverb.cpp **** 
 680:PhysPlateReverb.cpp ****         // ----- Find and prune close neighbors -----
 681:PhysPlateReverb.cpp ****         // MATLAB:
 682:PhysPlateReverb.cpp ****         //   [row] = find( omega > omega(m) - (cent_thresh/2)*omega(m)
 683:PhysPlateReverb.cpp ****         //               & omega < omega(m) + (cent_thresh/2)*omega(m)
 684:PhysPlateReverb.cpp ****         //               & omega ~= omega(m)
 685:PhysPlateReverb.cpp ****         //               & sigma > sigma(m) - (damp_thresh/2)*sigma(m)
 686:PhysPlateReverb.cpp ****         //               & sigma < sigma(m) + (damp_thresh/2)*sigma(m)
 687:PhysPlateReverb.cpp ****         //               & sigma ~= sigma(m) );
 688:PhysPlateReverb.cpp ****         //   omega_new(row) = 0;
 689:PhysPlateReverb.cpp ****         //
 690:PhysPlateReverb.cpp ****         // C++ TRANSLATION:
 691:PhysPlateReverb.cpp ****         // find() with multiple conditions → an inner for-loop with an
 692:PhysPlateReverb.cpp ****         // if-statement that checks ALL conditions simultaneously (&&).
 693:PhysPlateReverb.cpp ****         //
 694:PhysPlateReverb.cpp ****         // Compute the window bounds ONCE outside the inner loop:
 695:PhysPlateReverb.cpp ****         float half_freq_win = (cent_thresh * 0.5f) * raw_omega[m];
 696:PhysPlateReverb.cpp ****         float omega_lo = raw_omega[m] - half_freq_win;   // lower freq bound
 697:PhysPlateReverb.cpp ****         float omega_hi = raw_omega[m] + half_freq_win;   // upper freq bound
 698:PhysPlateReverb.cpp **** 
 699:PhysPlateReverb.cpp ****         float half_damp_win = (DAMP_THRESH * 0.5f) * raw_sigma[m];
 700:PhysPlateReverb.cpp ****         float sigma_lo = raw_sigma[m] - half_damp_win;   // lower damp bound
 701:PhysPlateReverb.cpp ****         float sigma_hi = raw_sigma[m] + half_damp_win;   // upper damp bound
 702:PhysPlateReverb.cpp **** 
 703:PhysPlateReverb.cpp ****         for (int j = 0; j < raw_count; j++)
 704:PhysPlateReverb.cpp ****         {
 705:PhysPlateReverb.cpp ****             if (j == m)         continue;   // skip self (MATLAB: omega~=omega(m))
 706:PhysPlateReverb.cpp ****             if (!raw_active[j]) continue;   // already pruned — no work to do
 707:PhysPlateReverb.cpp **** 
 708:PhysPlateReverb.cpp ****             // Check if mode j falls within BOTH the frequency AND damping
 709:PhysPlateReverb.cpp ****             // windows of mode m.  All conditions must be true (&&).
 710:PhysPlateReverb.cpp ****             if (raw_omega[j] > omega_lo && raw_omega[j] < omega_hi &&
 711:PhysPlateReverb.cpp ****                 raw_sigma[j] > sigma_lo && raw_sigma[j] < sigma_hi)
 712:PhysPlateReverb.cpp ****             {
 713:PhysPlateReverb.cpp ****                 // Mode j is too close to mode m → mark it as pruned
 714:PhysPlateReverb.cpp ****                 raw_active[j] = 0;   // ← MATLAB: omega_new(row) = 0
 715:PhysPlateReverb.cpp ****             }
 716:PhysPlateReverb.cpp ****         }
 717:PhysPlateReverb.cpp ****     }
 718:PhysPlateReverb.cpp **** 
 719:PhysPlateReverb.cpp **** 
 720:PhysPlateReverb.cpp ****     /* ===== Step 6: Compact surviving modes ===============================
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 28


 721:PhysPlateReverb.cpp ****      *
 722:PhysPlateReverb.cpp ****      * MATLAB:
 723:PhysPlateReverb.cpp ****      *   prunevec    = omega_new ~= 0;
 724:PhysPlateReverb.cpp ****      *   omega_new   = nonzeros(omega_new);
 725:PhysPlateReverb.cpp ****      *   sigma_new   = nonzeros(sigma .* prunevec);
 726:PhysPlateReverb.cpp ****      *   phi_i_new   = nonzeros(phi_i .* prunevec);
 727:PhysPlateReverb.cpp ****      *   phi_o_new   = nonzeros(phi_o .* prunevec);
 728:PhysPlateReverb.cpp ****      *
 729:PhysPlateReverb.cpp ****      * C++ TRANSLATION:
 730:PhysPlateReverb.cpp ****      * ────────────────
 731:PhysPlateReverb.cpp ****      * MATLAB's nonzeros() returns a shorter vector with all the zero
 732:PhysPlateReverb.cpp ****      * entries removed.  In C++ we loop through the raw arrays and copy
 733:PhysPlateReverb.cpp ****      * only the "active" entries into the class's final arrays, packing
 734:PhysPlateReverb.cpp ****      * them contiguously.  A counter (num_modes_) tracks the new length.
 735:PhysPlateReverb.cpp ****      *
 736:PhysPlateReverb.cpp ****      * This is the canonical C++ pattern for "logical indexing + compact":
 737:PhysPlateReverb.cpp ****      *   int count = 0;
 738:PhysPlateReverb.cpp ****      *   for (i) if (active[i]) final[count++] = raw[i];
 739:PhysPlateReverb.cpp ****      *
 740:PhysPlateReverb.cpp ****      * We also cap at MAX_MODES to stay within our CPU budget.
 741:PhysPlateReverb.cpp ****      * ====================================================================*/
 742:PhysPlateReverb.cpp ****     num_modes_ = 0;
 743:PhysPlateReverb.cpp ****     for (int i = 0; i < raw_count; i++)
 744:PhysPlateReverb.cpp ****     {
 745:PhysPlateReverb.cpp ****         if (!raw_active[i])
 746:PhysPlateReverb.cpp ****             continue;   // pruned — skip
 747:PhysPlateReverb.cpp **** 
 748:PhysPlateReverb.cpp ****         if (num_modes_ >= MAX_MODES)
 749:PhysPlateReverb.cpp ****             break;      // hit our CPU budget — stop adding modes
 750:PhysPlateReverb.cpp **** 
 751:PhysPlateReverb.cpp ****         // Copy this mode's data from temporary → final arrays
 752:PhysPlateReverb.cpp ****         omega_[num_modes_]   = raw_omega[i];
 753:PhysPlateReverb.cpp ****         beta_sq_[num_modes_] = raw_beta_sq[i];
 754:PhysPlateReverb.cpp ****         phi_i_[num_modes_]   = raw_phi_i[i];
 755:PhysPlateReverb.cpp ****         phi_o_l_[num_modes_] = raw_phi_o_l[i];
