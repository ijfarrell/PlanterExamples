 891:PhysPlateReverb.cpp **** 
 892:PhysPlateReverb.cpp **** /* ========================================================================
 893:PhysPlateReverb.cpp ****  * SECTION 6 — ProcessStereo()
 894:PhysPlateReverb.cpp ****  *
 895:PhysPlateReverb.cpp ****  * This is the PERFORMANCE-CRITICAL inner loop.  It runs once per audio
 896:PhysPlateReverb.cpp ****  * sample — at 48 kHz that's 48000 calls per second.  It must finish
 897:PhysPlateReverb.cpp ****  * within ~20 µs (one sample period).
 898:PhysPlateReverb.cpp ****  *
 899:PhysPlateReverb.cpp ****  * MATLAB equivalent — ONE iteration of "for n = 1:Nf":
 900:PhysPlateReverb.cpp ****  *
 901:PhysPlateReverb.cpp ****  *   p0      = B.*p1 + C.*p2 + D*in1(n);     ← vector arithmetic
 902:PhysPlateReverb.cpp ****  *   p2      = p1;                            ← copy entire vector
 903:PhysPlateReverb.cpp ****  *   p1      = p0;                            ← copy entire vector
 904:PhysPlateReverb.cpp ****  *   out1(n) = sum(phi_o_new .* p0);          ← dot product → scalar
 905:PhysPlateReverb.cpp ****  *
 906:PhysPlateReverb.cpp ****  * C++ TRANSLATION:
 907:PhysPlateReverb.cpp ****  * ────────────────
 908:PhysPlateReverb.cpp ****  * In MATLAB, "B.*p1" multiplies every element of B with every element
 909:PhysPlateReverb.cpp ****  * of p1 in a single expression, and "sum(phi_o .* p0)" does an element-
 910:PhysPlateReverb.cpp ****  * wise multiply then sums — i.e., a dot product.
 911:PhysPlateReverb.cpp ****  *
 912:PhysPlateReverb.cpp ****  * In C++ we handle ALL of this in ONE for-loop over modes:
 913:PhysPlateReverb.cpp ****  *   for each mode m:
 914:PhysPlateReverb.cpp ****  *     1) compute p0 = B[m]*p1[m] + C[m]*p2[m] + D[m]*input
 915:PhysPlateReverb.cpp ****  *     2) accumulate sum_l += phi_o_l[m] * p0   (dot product, one term)
 916:PhysPlateReverb.cpp ****  *     3) accumulate sum_r += phi_o_r[m] * p0
 917:PhysPlateReverb.cpp ****  *     4) shift:   p2[m] = p1[m];  p1[m] = p0;
 918:PhysPlateReverb.cpp ****  *
 919:PhysPlateReverb.cpp ****  * This single-pass approach is BETTER than MATLAB's separate vector
 920:PhysPlateReverb.cpp ****  * operations because it keeps each mode's data together in CPU cache.
 921:PhysPlateReverb.cpp ****  * MATLAB has to read/write the full arrays 4+ times; we touch each
 922:PhysPlateReverb.cpp ****  * mode's data exactly once.
 923:PhysPlateReverb.cpp ****  *
 924:PhysPlateReverb.cpp ****  * For STEREO: the state update (step 1) is identical for both channels
 925:PhysPlateReverb.cpp ****  * — we just add one extra multiply-accumulate per channel (steps 2-3).
 926:PhysPlateReverb.cpp ****  * This costs almost nothing compared to running two separate reverbs.
 927:PhysPlateReverb.cpp ****  * ========================================================================*/
 928:PhysPlateReverb.cpp **** void ModalPlateReverb::ProcessStereo(float input, float* out_l, float* out_r)
 929:PhysPlateReverb.cpp **** {
ARM GAS  C:\Users\isaia\AppData\Local\Temp\ccT6fYmT.s 			page 66


