1004:PhysPlateReverb.cpp **** /* ========================================================================
1005:PhysPlateReverb.cpp ****  * SECTION 7 — Daisy / Planter Boilerplate
1006:PhysPlateReverb.cpp ****  *
1007:PhysPlateReverb.cpp ****  * This section mirrors the structure of PlateReverb.cpp:
1008:PhysPlateReverb.cpp ****  *   1. Global hardware + DSP objects
1009:PhysPlateReverb.cpp ****  *   2. AudioCallback — called by hardware once per audio block
1010:PhysPlateReverb.cpp ****  *   3. main() — init + start
1011:PhysPlateReverb.cpp ****  *
1012:PhysPlateReverb.cpp ****  * The only change is replacing DaisySP's ReverbSc with our
1013:PhysPlateReverb.cpp ****  * ModalPlateReverb class.
1014:PhysPlateReverb.cpp ****  * ========================================================================*/
1015:PhysPlateReverb.cpp **** 
1016:PhysPlateReverb.cpp **** planter          euro;        // Planter hardware wrapper
1017:PhysPlateReverb.cpp **** ModalPlateReverb reverb;     // our physical modeling reverb
1018:PhysPlateReverb.cpp **** 
1019:PhysPlateReverb.cpp **** // Track previous T60 so we only recompute coefficients when knobs move
1020:PhysPlateReverb.cpp **** static float prev_t60_low  = -1.0f;
1021:PhysPlateReverb.cpp **** static float prev_t60_high = -1.0f;
1022:PhysPlateReverb.cpp **** static uint32_t last_control_update_ms = 0;
1023:PhysPlateReverb.cpp **** static constexpr uint32_t CONTROL_UPDATE_MS = 200;
1024:PhysPlateReverb.cpp **** 
1025:PhysPlateReverb.cpp **** // One-pole high-pass filter coefficients/states for send and wet return.
1026:PhysPlateReverb.cpp **** static float send_hpf_a = 0.0f;
1027:PhysPlateReverb.cpp **** static float wet_hpf_a  = 0.0f;
1028:PhysPlateReverb.cpp **** static float sample_dt  = 1.0f / 48000.0f;
1029:PhysPlateReverb.cpp **** static float send_x1 = 0.0f, send_y1 = 0.0f;
1030:PhysPlateReverb.cpp **** static float wet_x1 = 0.0f, wet_y1 = 0.0f;
1031:PhysPlateReverb.cpp **** 
1032:PhysPlateReverb.cpp **** // Smoothed runtime parameters to reduce zipper noise / coefficient jumps.
1033:PhysPlateReverb.cpp **** static float t60_low_sm  = 2.0f;
1034:PhysPlateReverb.cpp **** static float t60_high_sm = 0.5f;
1035:PhysPlateReverb.cpp **** static float dry_sm      = 0.5f;
1036:PhysPlateReverb.cpp **** static float wet_send_sm = 0.02f;
1037:PhysPlateReverb.cpp **** static float wet_mix_sm  = 0.10f;
1038:PhysPlateReverb.cpp **** static float send_hpf_hz_sm = 40.0f;
1039:PhysPlateReverb.cpp **** 
1040:PhysPlateReverb.cpp **** // Control targets are sampled at a slower control rate, then smoothed per callback.
1041:PhysPlateReverb.cpp **** static float t60_low_target_hold   = 2.0f;
1042:PhysPlateReverb.cpp **** static float t60_high_target_hold  = 0.5f;
