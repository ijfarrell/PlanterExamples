 862:PhysPlateReverb.cpp ****         // sig_0 + sig_1 * β²  gives the damping for this specific mode.
 863:PhysPlateReverb.cpp ****         // Low-β modes (low frequency) get less damping, high-β more.
 864:PhysPlateReverb.cpp ****         float sigma_m = sig_0 + sig_1 * beta_sq_[m];
