 939:PhysPlateReverb.cpp ****     {
 940:PhysPlateReverb.cpp ****         // ----- State update: p0 = B.*p1 + C.*p2 + D*input -----
 941:PhysPlateReverb.cpp ****         //
 942:PhysPlateReverb.cpp ****         // In MATLAB, B.*p1 is an element-wise multiply producing a
 943:PhysPlateReverb.cpp ****         // vector, then + C.*p2 adds another vector, then + D*input
 944:PhysPlateReverb.cpp ****         // adds a scalar-times-vector.  The result p0 is a vector.
 945:PhysPlateReverb.cpp ****         //
 946:PhysPlateReverb.cpp ****         // In C++ we compute ONE element of that vector per iteration.
 947:PhysPlateReverb.cpp ****         // p0 is a local scalar (not stored in an array), which lets the
 948:PhysPlateReverb.cpp ****         // compiler keep it in a CPU register — very fast.
 949:PhysPlateReverb.cpp ****         float p0 = B_[m] * p1_[m]      // B(m) * P^n(m)
