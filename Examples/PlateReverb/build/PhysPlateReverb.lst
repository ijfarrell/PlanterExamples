 953:PhysPlateReverb.cpp ****         // ----- Output accumulation (dot product, one term at a time) -----
 954:PhysPlateReverb.cpp ****         //
 955:PhysPlateReverb.cpp ****         // MATLAB: out1(n) = sum(phi_o_new .* p0)
 956:PhysPlateReverb.cpp ****         //
 957:PhysPlateReverb.cpp ****         // The sum() wrapping phi_o .* p0 is a DOT PRODUCT.  In C++ we
