 208:PhysPlateReverb.cpp **** 
 209:PhysPlateReverb.cpp **** static inline float ClampAudio(float x)
 210:PhysPlateReverb.cpp **** {
 211:PhysPlateReverb.cpp ****     if(x > OUTPUT_LIMIT) return OUTPUT_LIMIT;
 212:PhysPlateReverb.cpp ****     if(x < -OUTPUT_LIMIT) return -OUTPUT_LIMIT;
 213:PhysPlateReverb.cpp ****     return x;
 214:PhysPlateReverb.cpp **** }
